# Discord application bot token.
DISCORD_TOKEN=

# Address used by the dashboard HTTP server.
WEB_BIND=0.0.0.0:8080

# Long random value required by dashboard API requests.
DASHBOARD_TOKEN=change-me-to-a-long-random-secret

# Project directories.
SCRIPTS_DIR=scripts
DATA_DIR=data

# Lua sandbox limits per command execution.
LUA_MEMORY_BYTES=8388608
LUA_INSTRUCTION_LIMIT=250000
LUA_TIMEOUT_MS=100

# Logging filter.
RUST_LOG=zuckerbot=info,serenity=info,songbird=info,tower_http=info
