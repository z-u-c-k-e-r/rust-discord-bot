# Required by apps/bot
DISCORD_TOKEN=replace-me

# Recommended during development. Commands update immediately in this guild.
# Leave empty to publish global commands.
DISCORD_DEVELOPMENT_GUILD_ID=

# Discord privileged intents are disabled by default.
DISCORD_ENABLE_MESSAGE_CONTENT=false
DISCORD_ENABLE_GUILD_MEMBERS=false
DISCORD_ENABLE_GUILD_PRESENCES=false

PLUGIN_DIRECTORY=plugins
LUA_MEMORY_LIMIT_BYTES=16777216
LUA_INSTRUCTION_LIMIT=1000000

# Control API and dependencies
API_BIND_ADDRESS=0.0.0.0:8080
DATABASE_URL=postgres://zuckerbot:zuckerbot@localhost:5432/zuckerbot
REDIS_URL=redis://localhost:6379
POSTGRES_MAX_CONNECTIONS=10
DEPENDENCY_TIMEOUT_MS=2000
MIGRATION_TIMEOUT_SECONDS=30
API_RUN_MIGRATIONS=true

# Development-only bootstrap access to configuration endpoints.
# Configure both values together. Keep both empty in production.
# The token must contain at least 32 characters; actor ID must be a Discord snowflake.
CONTROL_PLANE_DEV_TOKEN=
CONTROL_PLANE_DEV_ACTOR_ID=

# Reserved for the Discord OAuth2 implementation in the next control-plane slice.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:8080/auth/discord/callback
SESSION_ENCRYPTION_KEY=
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800

RUST_LOG=info,zuckerbot_bot=debug,zuckerbot_api=debug
