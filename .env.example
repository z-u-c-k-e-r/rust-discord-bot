# Discord bot and application
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URL=http://127.0.0.1:8080/auth/discord/callback

# Register commands immediately in one development guild. Omit for global commands.
DISCORD_DEV_GUILD_ID=

# Dashboard
DASHBOARD_BIND=0.0.0.0:8080
DASHBOARD_PUBLIC_URL=http://127.0.0.1:8080
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800

# Storage. If omitted, an in-memory store is used for local development.
DATABASE_URL=postgres://zuckerbot:zuckerbot@postgres:5432/zuckerbot

# Lua sandbox
SCRIPTS_DIR=scripts
LUA_MEMORY_LIMIT_BYTES=8388608
LUA_INSTRUCTION_LIMIT=500000
LUA_HOOK_GRANULARITY=1000

# Comma-separated allowlist used when /music receives a URL.
MUSIC_ALLOWED_HOSTS=youtube.com,www.youtube.com,m.youtube.com,youtu.be,soundcloud.com,www.soundcloud.com,bandcamp.com
